test "k6 E2E" {
  tags = ["e2e", "k6"]

  step "load" {
    k6 {
      script = "k6-e2e.js"
      env = {
        LAMPLIGHT_K6_E2E = "ok"
      }
      arguments = {
        vus        = 1
        iterations = 1
      }
    }

    check "k6 completed" {
      response = {
        "exit code is zero" = response.json.exit_code == 0
      }
    }
  }
}
